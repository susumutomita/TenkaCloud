{
  "name": "tenkacloud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client/*",
    "packages/*",
    "server/application/libs/*",
    "server/application/microservices/*"
  ],
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n cp,app,tenant,problem,gameday,battle,score,leader,realtime -c blue,green,yellow,magenta,cyan,red,white,gray,blueBright \"bun run --cwd client/AdminWeb dev\" \"bun run --cwd client/Application dev\" \"bun run --cwd server/application/microservices/tenant-management dev\" \"bun run --cwd server/application/microservices/problem-service dev\" \"bun run --cwd server/application/microservices/gameday-service dev\" \"bun run --cwd server/application/microservices/battle-service dev\" \"bun run --cwd server/application/microservices/scoring-service dev\" \"bun run --cwd server/application/microservices/leaderboard-service dev\" \"bun run --cwd server/application/microservices/realtime-service dev\"",
    "dev:control-plane": "npm run dev --workspace=client/AdminWeb",
    "dev:app": "npm run dev --workspace=client/Application",
    "build:apps": "npm run build --workspaces --if-present",
    "test:apps": "npm run test --workspaces --if-present",
    "typecheck:apps": "npm run typecheck --workspaces --if-present",
    "lint:apps": "npm run lint --workspaces --if-present",
    "clean": "bun exec rimraf node_modules out",
    "install:ci": "bun install --no-frozen-lockfile --ignore-scripts",
    "test": "vitest run --config vitest.config.js --coverage --reporter=verbose",
    "test:watch": "vitest --config vitest.config.js",
    "test:ui": "vitest --ui --config vitest.config.js",
    "test:coverage": "vitest run --coverage --config vitest.config.js --reporter=verbose",
    "test:contracts": "hardhat test",
    "format": "bun run --cwd client/Application format && bun run --cwd client/AdminWeb format && bun run --cwd packages/shared format",
    "format_check": "bun run --cwd client/Application format_check && bun run --cwd client/AdminWeb format_check && bun run --cwd packages/shared format_check",
    "lint_text": "textlint \"**/*.md\"",
    "lint_text_fix": "textlint \"**/*.md\" --fix",
    "lint-staged": "lint-staged",
    "husky": "husky install",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/ni": "^27.0.1",
    "@types/bun": "latest",
    "@vitest/coverage-istanbul": "4.0.15",
    "concurrently": "^9.2.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "husky": "^9.1.4",
    "textlint": "^14.0.5",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.1",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.6.1",
    "textlint-rule-ja-no-abusage": "^3.0.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-no-double-negative-ja": "^2.0.1",
    "textlint-rule-no-dropping-the-ra": "^3.0.0",
    "textlint-rule-prefer-tari-tari": "^1.0.3",
    "textlint-rule-preset-ja-spacing": "^2.2.0",
    "textlint-rule-preset-ja-technical-writing": "^10.0.1",
    "textlint-rule-spellcheck-tech-word": "^5.0.0"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "brace-expansion": ">=2.0.3",
    "@isaacs/brace-expansion": ">=5.0.1",
    "flatted": ">=3.4.0",
    "lodash": ">=4.18.1",
    "diff": ">=5.2.2",
    "qs": ">=6.14.2",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "@modelcontextprotocol/sdk": ">=1.25.2",
    "fast-xml-parser": ">=5.5.6",
    "ajv": ">=8.18.0",
    "esbuild": ">=0.25.0",
    "rollup": ">=4.59.0",
    "nodemailer": ">=8.0.4",
    "yaml": ">=2.8.3",
    "hono": ">=4.12.10"
  }
}
