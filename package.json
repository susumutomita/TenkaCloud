{
  "name": "TenkaCloud",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "infrastructure",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run scripts/workspace/run-workspaces.ts build",
    "build:pages": "bun run generate:landing-locales && bun run generate:landing-docs && bun run --filter @TenkaCloud/participant-portal build:pages && mkdir -p landing/portal-demo && cp -r apps/participant-portal/dist/. landing/portal-demo/ && bun run --filter @TenkaCloud/application-admin-console build:pages && mkdir -p landing/admin-demo && cp -r apps/application-admin-console/dist/. landing/admin-demo/",
    "typecheck": "bun run scripts/workspace/run-workspaces.ts typecheck",
    "synth": "bun run --filter @TenkaCloud/infrastructure synth",
    "test": "bun run scripts/landing/generate-landing-locales.ts --check && bun run scripts/landing/generate-landing-docs.ts --check && bun test scripts/landing/landing-seo.test.ts scripts/workspace/run-coverage.test.ts scripts/workspace/run-workspaces.test.ts && bun run scripts/workspace/run-workspaces.ts test",
    "test:coverage": "bun run scripts/workspace/run-coverage.ts",
    "audit:dependencies": "bun run scripts/security/audit-dependencies.ts",
    "generate:landing-locales": "bun run scripts/landing/generate-landing-locales.ts",
    "generate:landing-docs": "bun run scripts/landing/generate-landing-docs.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#references' '#client' '#src' '#**/cdk.out/**' '#**/cdk.out.test/**' '#**/dist' '#problems/**' '#.cache/**'",
    "lint:text": "textlint '**/*.md' '!problems/**'",
    "lint:format": "biome check",
    "fix:md": "markdownlint-cli2 --fix '**/*.md' '#**/node_modules' '#references' '#client' '#src' '#**/cdk.out/**' '#**/cdk.out.test/**' '#**/dist' '#problems/**' '#.cache/**'",
    "fix:text": "textlint --fix '**/*.md'",
    "fix:format": "biome check --write",
    "prepare": "husky"
  },
  "trustedDependencies": [],
  "keywords": [],
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24"
  },
  "author": "Susumu Tomita (https://susumutomita.netlify.app/)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.22.1",
    "marked": "^18.0.3",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-number": "^1.0.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-spellcheck-tech-word": "^5.0.0"
  }
}
