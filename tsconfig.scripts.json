{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/security/audit-dependencies.ts",
    "scripts/lib/lite-residual-scan.ts",
    "scripts/lib/lite-residual-scan-aws.ts",
    "scripts/ops/scan-lite-residual-resources.ts",
    "scripts/release/manifest.ts",
    "scripts/release/generate-release-report.ts",
    "scripts/release/identity.ts",
    "scripts/release/verify-release-identity.ts",
    "scripts/release/launcher-baseline.ts"
  ]
}
