# Supply Chain Security 防御 (mini Shai-Hulud 第二波 / 2026-05 対策)
# https://blog.flatt.tech/entry/mini_shai_hulud_2nd
#
# 本リポジトリでは bun を package manager に使う前提だが、 contributor が誤って
# npm / yarn / pnpm を呼んでも自動で防御層が効くよう .npmrc に保険を入れる。

# lifecycle script (= preinstall / install / postinstall / prepare 等) の実行を block。
# 悪意ある transitive dep が postinstall で credential exfil / C2 接続を試みる手口
# (= "tanstack_runner.js" 型) に対するメイン防御。
ignore-scripts=true

# 公開後 7 日経っていない package version の install を block。
# Shai-Hulud 型攻撃は侵害後数時間で widely picked up されるため、
# install delay は incident response window を稼ぐ。
# npm 11+ の機能で、値は「日数」の Number (単位付き文字列は不可)。 `168h` と
# 書いていた時期は npm 11.16 が invalid config warning の後 pacote の
# `Date.toISOString()` で "Invalid time value" を投げ、npm pack を含む全 npm
# コマンドが失敗していた (release-cli run 31553277247)。 key を知らない古い
# npm は無視する (= 危害は無い)。
min-release-age=7

# audit level を high 以下も warn にする (= moderate 以上で `npm install` 警告)。
# CI で fail にするには `--audit-level=high` を別途指定する。
audit-level=moderate

# offline cache を信用 (= レジストリ汚染時の保険)。
prefer-offline=false

# Bun は本 file の `ignore-scripts` を直接読まない。 Bun には trustedDependencies
# モデルがあり (= package.json で明示した dep のみ lifecycle script 許可)、
# default で transitive lifecycle script は block されている。 詳細は AGENTS.md 参照。
