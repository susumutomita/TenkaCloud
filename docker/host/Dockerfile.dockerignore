# Build context for docker/host/Dockerfile (BuildKit reads this file instead of the
# root .dockerignore). The hosted image carries its catalog because a container
# platform has no checkout to bind-mount. Only the problems host mode offers
# are included. scripts/local-host/browser-metadata.ts narrows the UI build to
# reviewed public metadata and diagrams; CloudFormation templates stay on the host.
.git
.gitmodules
problems

node_modules
**/node_modules
**/dist
**/coverage
**/cdk.out
**/cdk.out.test
**/.turbo
.tenkacloud/
tmp/
.claude/
sampleimages/
docs/
landing/
apps/participant-portal/public/runtime-config.json
apps/participant-portal/public/runtime-config.backup.json

# Mirror the root .dockerignore's secret exclusions: this file replaces it.
.env
**/.env
**/.env.*
!**/.env.example

# Only validated downloaded source bytes re-enter the context, never host state or credentials.
!.tenkacloud/
.tenkacloud/*
!.tenkacloud/catalog-store/
.tenkacloud/catalog-store/*
!.tenkacloud/catalog-store/selected.json
!.tenkacloud/catalog-store/snapshots/
!.tenkacloud/catalog-store/snapshots/**
