{
  "format": ["typescript", "tsx", "javascript"],
  "pattern": "{apps,packages,scripts,.claude}/**/*.{ts,tsx,js}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/cdk.out/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test/**",
    "**/__tests__/**",
    "apps/developer-portal/src/content/reference-data.ts",
    "apps/developer-portal/src/content/machine-api.generated.ts",
    "problems/**",
    "landing/**"
  ],
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["consoleFull", "json"],
  "output": ".jscpd-report",
  "absolute": false,
  "gitignore": true
}
