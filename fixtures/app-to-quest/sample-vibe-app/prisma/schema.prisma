generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  email       String   @unique
  name        String
  role        String
  lastLoginIp String
  orders      Order[]
  createdAt   DateTime @default(now())
}

model Order {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amountCents     Int
  itemsJson       String
  note            String
  shippingAddress String
  createdAt       DateTime @default(now())
}
