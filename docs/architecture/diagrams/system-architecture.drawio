                <mxCell id="uc-bootstrap" value="競技用アカウントの IAM 初期設定を承認する&#xa;共通ロール・必須 ExternalId" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="990" y="465" width="720" height="70" as="geometry" /></mxCell>
                <mxCell id="uc-platform" value="make deploy / make destroy（対象 installation を確認）&#xa;通常は AWS 基盤・既定データを削除&#xa;競技環境の撤去は --drain-events を明示" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="990" y="665" width="720" height="70" as="geometry" /></mxCell>
