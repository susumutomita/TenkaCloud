                <mxCell id="cloud-cli" value="make deploy / make destroy（AWS 基盤・既定データを削除）&#xa;競技環境は --drain-events を明示／外部 Turso は通常保持" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=13;align=center;verticalAlign=middle" vertex="1" parent="aws-account"><mxGeometry x="50" y="350" width="880" height="80" as="geometry" /></mxCell>
                <mxCell id="mode-local-host" value="local&#xa;単一 Bun プロセス + SQLite&#xa;開催管理・参加者画面・native Cryptography Battle" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=13;align=center;verticalAlign=middle" vertex="1" parent="pc"><mxGeometry x="50" y="110" width="880" height="100" as="geometry" /></mxCell>
