                <mxCell id="actor-operator" value="運用者" style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.user" vertex="1" parent="1"><mxGeometry x="2230" y="900" width="60" height="60" as="geometry" /></mxCell>
                <mxCell id="uc-event" value="大会・チーム・日程を管理する&#xa;local / cloud" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="90" y="65" width="720" height="70" as="geometry" /></mxCell>
                <mxCell id="uc-team-key" value="大会に属するチームキーを発行・再発行する&#xa;local / cloud" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="90" y="165" width="720" height="70" as="geometry" /></mxCell>
                <mxCell id="uc-deploy" value="問題を準備・配置・撤去する&#xa;Compose は local / AWS 問題は cloud" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="90" y="265" width="720" height="70" as="geometry" /></mxCell>
                <mxCell id="uc-competitor" value="競技用アカウントを登録・検証する&#xa;cloud（開催基盤のアカウントとは分離）" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="90" y="365" width="720" height="70" as="geometry" /></mxCell>
                <mxCell id="uc-notify" value="得点を確認し、採点をロック・大会を終了する&#xa;local / cloud" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#405A78;strokeWidth=1.5;fontColor=#16191F;fontSize=12;align=center;verticalAlign=middle" vertex="1" parent="tenkacloud"><mxGeometry x="90" y="465" width="720" height="70" as="geometry" /></mxCell>
