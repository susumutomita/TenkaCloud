<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="community-local" name="01 Local competition candidate">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Unpublished candidate: one event/team competition system" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1080" height="50" as="geometry" />
        </mxCell>
        <mxCell id="organizer" value="Organizer browser&#10;Admin / Operator / Viewer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="participant" value="Participant browser&#10;Event-owned team key" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="host" value="Single Bun process&#10;HTTP authorization, events, scoring, ownership" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="235" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Local SQLite + original private keys&#10;Durable state and recovery" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="On-demand Compose / workbench&#10;512 dormant jobs; team 3 / host 12 active&#10;4096 MiB cap budget; 40 active gateways" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="880" y="360" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lifecycle" value="make down stops owned Docker; make local waits for participant resume&#10;Writable layers and volumes survive, not RAM; no automatic eviction or reset&#10;Existing events keep legacy lifecycle; AWS stacks and event clock remain" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="210" y="540" width="780" height="90" as="geometry" />
        </mxCell>
        <mxCell id="coverage" value="106 entries are not full playability proof; synthetic 100 jobs / 105 ports is not a benchmark&#10;Terminal HTTP/WS tested with synthetic shell; actual Docker exec / browser checks incomplete" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#405a78;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="210" y="655" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="Organizer authentication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;strokeColor=#405a78;fontSize=13;" edge="1" parent="1" source="organizer" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="Team authentication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;strokeColor=#405a78;fontSize=13;" edge="1" parent="1" source="participant" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="Transactional state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;strokeColor=#405a78;fontSize=13;" edge="1" parent="1" source="host" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="Owned lifecycle / private verifier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;strokeColor=#405a78;fontSize=13;" edge="1" parent="1" source="host" target="runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="exercise-aws" name="02 Optional AWS exercises">
