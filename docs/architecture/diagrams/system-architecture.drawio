                <mxCell id="operator" value="運用者（AWS 権限）" style="fontColor=#16191F;fillColor=#242F3E;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.user" vertex="1" parent="1"><mxGeometry x="170" y="680" width="60" height="60" as="geometry" /></mxCell>
