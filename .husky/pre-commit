#!/usr/bin/env sh
# Check the staged catalog pin without fetching, changing branches, or hiding failures.
catalog_status=$(git submodule status -- problems) || exit 1
case "$catalog_status" in
  " "*) ;;
  *)
    echo "problems/ is uninitialized or differs from its staged commit." >&2
    echo "Align the checkout deliberately, or stage an intended catalog update. No checkout was changed." >&2
    exit 1
    ;;
esac

mise exec -- make before-commit
