{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/cdk.out/**",
    "**/cdk.out.test/**",
    "**/coverage/**",
    "**/*.d.ts",
    "apps/developer-portal/src/app/**/page.ja.mdx",
    ".claude/**",
    "problems/**",
    "packs/**",
    "landing/**",
    "references/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error",
    "types": "error",
    "files": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
    "enumMembers": "off",
    "nsExports": "off",
    "nsTypes": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/form/setup.ts",
        "scripts/landing/generate-landing-docs.ts",
        "scripts/landing/generate-landing-locales.ts",
        "scripts/landing/stamp-asset-versions.ts",
        "scripts/landing/onboarding-videos/render-*.ts",
        "scripts/local-play/server.ts",
        "scripts/local-play/api.ts",
        "scripts/local-play/local-smoke.ts",
        "scripts/local/measure-profile.ts",
        "scripts/onboarding/verify-custom-challenge.ts",
        "scripts/openapi/generate.ts",
        "scripts/ops/*.ts",
        "scripts/quality/*.ts",
        "scripts/release/generate-release-report.ts",
        "scripts/security/*.ts",
        "scripts/workspace/*.ts",
        "scripts/**/*.test.ts",
        "scripts/**/*.test-helpers.ts"
      ],
      "project": ["scripts/**/*.ts"]
    },
    "infrastructure": {
      "entry": [
        "bin/*.ts",
        "lib/**/handlers/**/index.ts",
        "lib/**/handler/index.ts",
        "lib/**/handlers/handler.ts",
        "lib/problem-pack/pack-cli.ts",
        "test/**/*.ts"
      ],
      "project": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
    },
    "apps/admin-console": {
      "project": ["src/**"]
    },
    "apps/application-admin-console": {
      "project": ["src/**"]
    },
    "apps/participant-portal": {
      "project": ["src/**"]
    },
    "apps/developer-portal": {
      "entry": ["scripts/**/*.ts"],
      "project": ["src/**", "scripts/**"]
    },
    "packages/*": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**", "test/**"]
    }
  }
}
