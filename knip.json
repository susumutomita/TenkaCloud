{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/cdk.out/**",
    "**/cdk.out.test/**",
    "**/coverage/**",
    "**/*.d.ts",
    "apps/developer-portal/src/app/**/page.ja.mdx",
    ".claude/**",
    "problems/**",
    "packs/**",
    "landing/**",
    "references/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error",
    "types": "error",
    "files": "error",
    "duplicates": "error",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
    "enumMembers": "off",
    "nsExports": "off",
    "nsTypes": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/form/setup.ts",
        "scripts/landing/generate-landing-docs.ts",
        "scripts/landing/generate-landing-locales.ts",
        "scripts/landing/stamp-asset-versions.ts",
        "scripts/landing/onboarding-videos/render-*.ts",
        "scripts/onboarding/verify-custom-challenge.ts",
        "scripts/ops/*.ts",
        "scripts/quality/*.ts",
        "scripts/security/*.ts",
        "scripts/workspace/*.ts",
        "scripts/**/*.test.ts",
        "scripts/**/*.test-helpers.ts",
        "scripts/local-host/main.ts",
        "scripts/local-host/build-main.ts",
        "scripts/local-host/tests/run.ts",
        "scripts/local-host/tests/docker-smoke.ts",
        "scripts/local-host/tests/e2e-host.ts",
        "scripts/local-host/tests/browser-e2e.ts",
        "scripts/local-host/tests/cloud-browser-e2e.ts",
        "scripts/problem-pack/main.ts",
        "scripts/release/host-candidate.ts",
        "scripts/local-host/tests/disruption-browser-e2e.ts",
        "scripts/local-host/tests/uptime-browser-e2e.ts",
        "scripts/local-host/tests/progression-browser-e2e.ts",
        "scripts/local-host/tests/organizer-browser-e2e.ts",
        "scripts/local-host/tests/accounts-browser-e2e.ts",
        "scripts/local-host/tests/participant-aws-browser-e2e.ts",
        "scripts/local-host/tests/saml-browser-e2e.ts",
        "scripts/local-host/tests/audit-browser-e2e.ts",
        "scripts/local-host/tests/registration-browser-e2e.ts",
        "scripts/cloud-hosting/main.ts"
      ],
      "project": ["scripts/**/*.ts"]
    },
    "apps/application-admin-console": {
      "project": ["src/**"],
      "entry": [
        "src/main.tsx",
        "test/**/*.test.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "vite.host.config.ts"
      ]
    },
    "apps/participant-portal": {
      "project": ["src/**"],
      "entry": [
        "src/main.tsx",
        "test/**/*.test.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/local-host/main.tsx",
        "vite.host.config.ts"
      ]
    },
    "apps/developer-portal": {
      "entry": ["scripts/**/*.ts"],
      "project": ["src/**", "scripts/**"]
    },
    "packages/*": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**", "test/**"]
    },
    "infrastructure": {
      "entry": ["bin/**/*.ts", "lib/problem-deploy/handlers/*/index.ts", "test/**/*.ts"],
      "project": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
    }
  }
}
