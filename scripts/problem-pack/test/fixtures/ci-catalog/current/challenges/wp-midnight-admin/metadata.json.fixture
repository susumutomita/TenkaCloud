  "scoring": {
    "kind": "multi-verify",
    "hintReveal": "flat",
    "checks": [
      {
        "id": "rogue-admin",
        "label": "身に覚えのない管理者",
        "points": 50,
        "wrongAnswerPenalty": 3,
        "hints": [
          {
            "id": "rogue-admin-1",
            "content": "インシデントで最初に確かめるのは 「誰が」 だ。 まず、 今このサイトに何人の利用者 (投稿者) がいて、 それぞれ身に覚えがあるかを確認しよう。 WordPress はその一覧を外部に見せてしまうことがある。",
            "penalty": 0
          },
          {
            "id": "rogue-admin-2",
            "content": "Fixture wp-midnight-admin: .scoring.checks.0.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 6
          },
          {
            "id": "rogue-admin-3",
            "content": "アクセス先 URL の `/wp-json/wp/v2/users` を開くと、 誰も追加していない管理者 `media-sync` が混じっている。 その `description` (bio) に監査用の合言葉が書かれている。 対策: 不審な管理者アカウントは即削除し、 全管理者を棚卸しする。",
            "penalty": 12
          }
        ]
      },
      {
        "id": "login-trail",
        "label": "破られた入口",
        "points": 50,
        "wrongAnswerPenalty": 3,
        "hints": [
          {
            "id": "login-trail-1",
            "content": "「誰が」 の次は 「どうやって入ったか」 だ。 侵入者はどこかから入っている。 サーバが記録しているアクセスの記録 (ログ) を読めば、 失敗の山と 1 回の成功が見える。",
            "penalty": 0
          },
          {
            "id": "login-trail-2",
            "content": "運用者がログを公開フォルダに置き忘れていることがある。 `/server-logs/` の下のアクセスログ (`access.log`) を開き、 同じ IP から `POST /wp-login.php` が何度も失敗している 「総当たり」 の跡を探そう。",
            "penalty": 6
          },
          {
            "id": "login-trail-3",
            "content": "Fixture wp-midnight-admin: .scoring.checks.1.hints.2.content. Synthetic narrative for platform contract tests.",
            "penalty": 12
          }
        ]
      },
      {
        "id": "orphan-plugin",
        "label": "放置されたプラグイン",
        "points": 50,
        "wrongAnswerPenalty": 3,
        "hints": [
          {
            "id": "orphan-plugin-1",
            "content": "侵入経路を調べるついでに、 サイトに入っている拡張機能 (プラグイン) を棚卸ししよう。 長年更新されていない放置プラグインは、 それ自体がリスクの温床だ。",
            "penalty": 0
          },
          {
            "id": "orphan-plugin-2",
            "content": "WordPress のプラグインは `/wp-content/plugins/<名前>/readme.txt` という説明ファイルを公開している。 中の `Stable tag` や `Tested up to` を見れば、 いつから更新が止まっているかがわかる。",
            "penalty": 6
          },
          {
            "id": "orphan-plugin-3",
            "content": "アクセス先 URL の `/wp-content/plugins/legacy-contact-form/readme.txt` を開くと、 `Tested up to: 4.9` という古いプラグインで、 運用メモ (NOTE) の行に合言葉がある。 対策: 使っていない / 放置されたプラグインは削除し、 残すものは最新に保つ。",
            "penalty": 12
          }
        ]
      },
      {
        "id": "spam-post",
        "label": "見知らぬ投稿",
        "points": 50,
        "wrongAnswerPenalty": 3,
        "hints": [
          {
            "id": "spam-post-1",
            "content": "最後は 「侵入者が何をしたか」 だ。 管理者を乗っ取った相手は、 たいてい痕跡 (投稿・リンク) を残す。 公開されている投稿の一覧を、 書いた覚えがあるか眺めよう。",
            "penalty": 0
          },
          {
            "id": "spam-post-2",
            "content": "投稿の一覧も REST で取れる: `/wp-json/wp/v2/posts`。 見知らぬ宣伝 (スパム) 投稿が混じっていないか探し、 その本文の 「元の HTML」 (ページのソース) まで覗こう。 合言葉は表示されない場所に隠れていることがある。",
            "penalty": 6
          },
          {
            "id": "spam-post-3",
            "content": "Fixture wp-midnight-admin: .scoring.checks.3.hints.2.content. Synthetic narrative for platform contract tests.",
            "penalty": 12
          }
        ]
      }
    ]
  },
  "track": {
    "id": "stackstack-route",
    "order": 90,
    "chapter": "3. 運用で直す"
