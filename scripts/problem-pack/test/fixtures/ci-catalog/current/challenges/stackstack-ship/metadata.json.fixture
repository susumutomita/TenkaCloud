  },
  "runtime": {
    "provider": "docker",
    "engine": "compose",
    "entry": "local/docker-compose.yml",
    "challengeEndpoints": {
      "Ops": "http://127.0.0.1:18080/shipyard",
      "Public": "http://127.0.0.1:18080/site"
    },
    "verifyUrl": "http://127.0.0.1:18081/verify",
    "secretEnv": [
      "FLAG_SEED"
    ]
  },
  "scoring": {
    "kind": "multi-verify",
    "checks": [
      {
        "id": "built-artifact",
        "label": "配るものを突き止める",
        "points": 20,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "ship-artifact-1",
            "content": "あなたが来る前に、 何かがビルドされています。 そして、 それを配っているものは 1 つもありません。 リリース基盤は手元にあるものの一覧を持っています。 まずその一覧を出させてください。",
            "penalty": 0
          },
          {
            "id": "ship-artifact-2",
            "content": "`/docs` から `GET /shipyard/artifacts` を実行すると、 `artifacts` に id がちょうど 1 つ返ります。 それをそのまま提出してください。 初期 manifest の id は別のマシンで焼いたビルドなので違います。",
            "penalty": 8
          }
        ]
      },
      {
        "id": "release-receipt",
        "label": "リリースを 1 本通す",
        "points": 40,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "ship-receipt-1",
            "content": "`POST /shipyard/releases` はパイプラインを走らせ、 進めなかった最初の stage で止まって、 その stage 名と理由を返します。 その行が言っていることを直して、 もう一度打つ。 これを繰り返してください。 リリースがついに live になったときに書かれるログ行に、 このチェックポイントが求めている値が入っています。",
            "penalty": 0
          },
          {
            "id": "ship-receipt-2",
            "content": "Fixture stackstack-ship: .scoring.checks.1.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 16
          }
        ]
      },
      {
        "id": "published-title",
        "label": "公開側の見出しを差し替える",
        "points": 40,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "ship-title-1",
            "content": "公開側の入口に出る見出しは、 板の設定ファイルから来ていません。 リリースから来ています。 リリース側で書き換えて、 もう一度デプロイして、 外が実際に何を返しているかを見てください。",
            "penalty": 0
          },
          {
            "id": "ship-title-2",
            "content": "Fixture stackstack-ship: .scoring.checks.2.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 16
          }
        ]
      },
      {
        "id": "rotation-survives",
        "label": "鍵の入れ替えをまたぐ",
        "points": 60,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "ship-rotation-1",
            "content": "本番の鍵は入れ替わります。 `/shipyard/secrets` にあるものを自分で入れ替えて、 そのあと公開側の入口がどうなるかを見てください。 `GET /posture` の gate は、 何も壊さずに同じことを見ています。 採点があなたの代わりに鍵を入れ替えることはありません。",
            "penalty": 0
          },
          {
            "id": "ship-rotation-2",
            "content": "Fixture stackstack-ship: .scoring.checks.3.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 28
          }
        ]
      },
      {
        "id": "clean-cutover",
        "label": "止めずに片付ける",
        "points": 40,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "ship-cutover-1",
            "content": "`GET /posture` は走っている plane から実測した 3 つの gate を返します。 合格印は 3 つとも true になって初めて出ます。 false の gate がそのまま次にやることです。 そのうち 1 つは、 うまくいかなかった試行の残骸についてのものです。",
            "penalty": 0
          },
          {
            "id": "ship-cutover-2",
            "content": "Fixture stackstack-ship: .scoring.checks.4.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 16
          }
        ]
      }
    ]
  },
  "track": {
    "id": "stackstack-route",
    "order": 100,
    "chapter": "4. StackStack 本編"
  }
}
