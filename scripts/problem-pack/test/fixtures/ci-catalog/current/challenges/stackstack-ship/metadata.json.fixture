{
  "$schema": "../../SCHEMA.json",
  "id": "stackstack-ship",
  "name": "外から見えるところまで",
  "category": "Challenge",
  "status": "ready",
  "visibility": "public",
  "difficulty": 3,
  "estimatedDuration": "45 分",
  "shortDescription": "Fixture stackstack-ship: .shortDescription. Synthetic narrative for platform contract tests.",
  "instructions": "Fixture stackstack-ship: .instructions. Synthetic narrative for platform contract tests.",
  "description": "Fixture stackstack-ship: .description. Synthetic narrative for platform contract tests.",
  "writeup": "Fixture stackstack-ship: .writeup. Synthetic narrative for platform contract tests.",
  "tags": [
    "stackstack",
    "deploy",
    "release",
    "secrets",
    "health-check",
    "local-play",
    "container",
    "web-app"
  ],
  "exposedPorts": [
    {
      "port": 18080,
      "name": "Web (board / shipyard / site)"
    },
    {
      "port": 18081,
      "name": "/verify (loopback)"
    }
  ],
  "learningGoals": [
    "ビルド済みの成果物が存在することと、 それが配られていることが別の事実だと区別できる",
    "stage 単位のデプロイログから、 止まった原因と次に直す場所を切り分けられる",
    "秘密を値で渡すか参照で渡すかで、 入れ替え時の壊れ方が変わることを挙動で説明できる",
    "デプロイの成功記録ではなく、 公開側の応答で正常性を確認する習慣をつける"
  ],
  "i18n": {
    "en": {
      "name": "As Far As the Outside",
      "shortDescription": "Fixture stackstack-ship: .i18n.en.shortDescription. Synthetic narrative for platform contract tests.",
      "instructions": "Fixture stackstack-ship: .i18n.en.instructions. Synthetic narrative for platform contract tests.",
      "description": "Fixture stackstack-ship: .i18n.en.description. Synthetic narrative for platform contract tests.",
      "writeup": "Fixture stackstack-ship: .i18n.en.writeup. Synthetic narrative for platform contract tests.",
      "learningGoals": [
        "Separate \"the artifact exists\" from \"the artifact is being served\" as two distinct facts",
        "Use a stage-by-stage deploy log to isolate why a release stopped and what to fix next",
        "Explain, from observed behaviour, how passing a secret by value differs from passing it by reference when the secret rotates",
        "Confirm health from what the public side answers rather than from a successful deployment record"
      ],
      "checks": [
        {
          "id": "built-artifact",
          "label": "Identify what gets shipped",
          "hints": [
            {
              "id": "ship-artifact-1",
              "content": "Something was built before you arrived, and nothing is serving it. The release plane keeps a list of what it has on hand — ask it for that list."
            },
            {
              "id": "ship-artifact-2",
              "content": "Fixture stackstack-ship: .i18n.en.checks.0.hints.1.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "release-receipt",
          "label": "Get one release through",
          "hints": [
            {
              "id": "ship-receipt-1",
              "content": "Fixture stackstack-ship: .i18n.en.checks.1.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "ship-receipt-2",
              "content": "Fixture stackstack-ship: .i18n.en.checks.1.hints.1.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "published-title",
          "label": "Change what the outside sees",
          "hints": [
            {
              "id": "ship-title-1",
              "content": "Fixture stackstack-ship: .i18n.en.checks.2.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "ship-title-2",
              "content": "Fixture stackstack-ship: .i18n.en.checks.2.hints.1.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "rotation-survives",
          "label": "Survive a key rotation",
          "hints": [
            {
              "id": "ship-rotation-1",
              "content": "Fixture stackstack-ship: .i18n.en.checks.3.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "ship-rotation-2",
              "content": "Fixture stackstack-ship: .i18n.en.checks.3.hints.1.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "clean-cutover",
          "label": "Clean up without an outage",
          "hints": [
            {
              "id": "ship-cutover-1",
              "content": "Fixture stackstack-ship: .i18n.en.checks.4.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "ship-cutover-2",
