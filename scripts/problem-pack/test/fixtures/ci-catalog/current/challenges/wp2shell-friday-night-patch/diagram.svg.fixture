<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 300" font-family="Helvetica,Arial,sans-serif">
<defs><marker id="a" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#64748B"/></marker></defs>
<rect x="0" y="0" width="680" height="300" fill="#FFFFFF"/>
<text x="340" y="26" text-anchor="middle" font-size="16" font-weight="700" fill="#0F172A">Friday Night Patch -- contain, patch, keep the site up</text>

<rect x="20" y="52" width="120" height="50" rx="8" fill="#F8FAFC" stroke="#64748B" stroke-width="2"/>
<text x="80" y="72" text-anchor="middle" font-size="11" font-weight="700" fill="#334155">Public traffic</text>
<text x="80" y="88" text-anchor="middle" font-size="10" fill="#334155">attacker + legit</text>

<rect x="180" y="52" width="140" height="50" rx="8" fill="#FEF2F2" stroke="#DC2626" stroke-width="2"/>
<text x="250" y="72" text-anchor="middle" font-size="11" font-weight="700" fill="#7F1D1D">WAFv2 WebACL</text>
<text x="250" y="88" text-anchor="middle" font-size="10" fill="#7F1D1D">rule: Count -&gt; Block</text>

<rect x="360" y="52" width="140" height="50" rx="8" fill="#F8FAFC" stroke="#64748B" stroke-width="2"/>
<text x="430" y="72" text-anchor="middle" font-size="11" font-weight="700" fill="#334155">API Gateway</text>
<text x="430" y="88" text-anchor="middle" font-size="10" fill="#334155">REGIONAL, {proxy+}</text>

<rect x="540" y="52" width="120" height="50" rx="8" fill="#F8FAFC" stroke="#64748B" stroke-width="2"/>
<text x="600" y="72" text-anchor="middle" font-size="11" font-weight="700" fill="#334155">AppFunction</text>
<text x="600" y="88" text-anchor="middle" font-size="10" fill="#334155">Lambda (Python)</text>

<line x1="140" y1="77" x2="177" y2="77" stroke="#64748B" stroke-width="2" marker-end="url(#a)"/>
<line x1="320" y1="77" x2="357" y2="77" stroke="#64748B" stroke-width="2" marker-end="url(#a)"/>
<line x1="500" y1="77" x2="537" y2="77" stroke="#64748B" stroke-width="2" marker-end="url(#a)"/>

<rect x="360" y="140" width="300" height="56" rx="8" fill="#FEF9E7" stroke="#B7791F" stroke-width="2"/>
<text x="510" y="162" text-anchor="middle" font-size="11" font-weight="700" fill="#7C5A0A">SSM config/data/site (7 params)</text>
<text x="510" y="178" text-anchor="middle" font-size="10" fill="#7C5A0A">route-isolation, parameterized-queries, salt-version,</text>
<text x="510" y="191" text-anchor="middle" font-size="9.5" fill="#7C5A0A">rogue-admin, persistence-marker, theme-functions</text>

<line x1="600" y1="102" x2="530" y2="138" stroke="#B7791F" stroke-width="2" marker-end="url(#a)"/>

<rect x="20" y="140" width="300" height="56" rx="8" fill="#EFF6FF" stroke="#2563EB" stroke-width="2"/>
<text x="170" y="162" text-anchor="middle" font-size="11" font-weight="700" fill="#1E3A8A">EvidenceBucket (S3, private)</text>
<text x="170" y="178" text-anchor="middle" font-size="10" fill="#1E3A8A">incident-log.json -- timeline,</text>
<text x="170" y="191" text-anchor="middle" font-size="9.5" fill="#1E3A8A">suspicious request, audit_token flag</text>

<line x1="360" y1="168" x2="322" y2="168" stroke="#2563EB" stroke-width="2" marker-end="url(#a)"/>

<rect x="180" y="230" width="320" height="52" rx="8" fill="#F0FDF4" stroke="#16A34A" stroke-width="2"/>
<text x="340" y="251" text-anchor="middle" font-size="11" font-weight="700" fill="#14532D">You: invoke {"action":"grade","check":"&lt;id&gt;"}</text>
<text x="340" y="267" text-anchor="middle" font-size="10" fill="#14532D">Lambda replays live traffic, then reveals that flag</text>

<line x1="600" y1="102" x2="420" y2="228" stroke="#16A34A" stroke-width="2" marker-end="url(#a)"/>
</svg>
