  },
  "runtime": {
    "provider": "docker",
    "engine": "compose",
    "entry": "local/docker-compose.yml",
    "challengeEndpoints": {
      "Review": "http://127.0.0.1:18080/portal",
      "Board": "http://127.0.0.1:18080/"
    },
    "verifyUrl": "http://127.0.0.1:18081/verify",
    "secretEnv": [
      "FLAG_SEED"
    ]
  },
  "scoring": {
    "kind": "multi-verify",
    "checks": [
      {
        "id": "exposed-record",
        "label": "取引先の下書きに書かれていた管理番号",
        "points": 30,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "exp-record-1",
            "content": "レビュー画面には、 まだ触っていない下書きのルートが並んでいます。 下書きは 1 件ずつ 「誰のものか」 と 「どのテナントのものか」 を持っています。 ステージング用の鍵のどれかで一覧を出して、 返ってきたものの owner と tenant を見てください。",
            "penalty": 4
          },
          {
            "id": "exp-record-2",
            "content": "Fixture stackstack-safe-exposure: .scoring.checks.0.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 9
          }
        ]
      },
      {
        "id": "admin-sealed",
        "label": "管理画面を管理者だけに戻す",
        "points": 50,
        "wrongAnswerPenalty": 3,
        "hints": [
          {
            "id": "admin-seal-1",
            "content": "`/docs` から `GET /portal/review` を実行し、 `groups.admin_sealed.probes` の失敗項目を見ます。 どの rule が決めたか (`decidedBy`) も出ます。 admin 側は gate が 2 つあり、 両方同時に true でないと通りません。",
            "penalty": 5
          },
          {
            "id": "admin-seal-2",
            "content": "落とすべき probe は全員、 このアプリが知っている鍵を出しています。 だから 「鍵を要求する」 だけでは 1 本も変わりません。 cto-daichi と他の 3 人を分けているものは `/portal/me` に出ています。 admin の surface は 4 ルートあって、 そのうち 1 本は GET ではないことも忘れずに。",
            "penalty": 7
          },
          {
            "id": "admin-seal-3",
            "content": "Fixture stackstack-safe-exposure: .scoring.checks.1.hints.2.content. Synthetic narrative for platform contract tests.",
            "penalty": 11
          }
        ]
      },
      {
        "id": "drafts-sealed",
        "label": "下書きを持ち主と共有先だけに戻す",
        "points": 60,
        "wrongAnswerPenalty": 3,
        "hints": [
          {
            "id": "drafts-seal-1",
            "content": "下書きは `owner` と `tenant` と `visibility` を持っています。 最初からある 4 件のうち、 ちょうど 1 件は 「書いていない同僚が読めたままでよい」 もので、 よく似たもう 1 件は違います。 その差は caller ではなく、 オブジェクト自身に書いてあります。",
            "penalty": 6
          },
          {
            "id": "drafts-seal-2",
            "content": "Fixture stackstack-safe-exposure: .scoring.checks.2.hints.1.content. Synthetic narrative for platform contract tests.",
            "penalty": 9
          },
          {
            "id": "drafts-seal-3",
            "content": "Fixture stackstack-safe-exposure: .scoring.checks.2.hints.2.content. Synthetic narrative for platform contract tests.",
            "penalty": 13
          }
        ]
      },
      {
        "id": "exposure-signoff",
        "label": "公開範囲レビューの合格印",
        "points": 60,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "signoff-1",
            "content": "`GET /posture` は gate を 5 つ返します。 合格印は 5 つとも true になって初めて出ます。 null の間は、 赤い gate がそのままやることリストです。 どの probe が落ちていて、 どの rule が決めたかは `GET /portal/review` に出ています。",
            "penalty": 8
          },
          {
            "id": "signoff-2",
            "content": "`/docs` から `GET /posture` を実行し、 `readyToken` を提出してください。 `service_intact` が赤なら締めすぎです。 監視経路は鍵なしで答え、 4 アカウントとも `/portal/me` に届き、 共有 runbook は共有先の同僚が読める必要があります。",
            "penalty": 15
          }
        ]
      }
    ]
  },
  "track": {
    "id": "stackstack-route",
    "order": 120,
    "chapter": "4. StackStack 本編"
  }
}
