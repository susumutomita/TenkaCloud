{
  "$schema": "../../SCHEMA.json",
  "id": "stackstack-safe-exposure",
  "name": "誰に見せるかを決める",
  "category": "Challenge",
  "status": "ready",
  "visibility": "public",
  "difficulty": 3,
  "estimatedDuration": "60〜75 分",
  "shortDescription": "Fixture stackstack-safe-exposure: .shortDescription. Synthetic narrative for platform contract tests.",
  "instructions": "Fixture stackstack-safe-exposure: .instructions. Synthetic narrative for platform contract tests.",
  "description": "Fixture stackstack-safe-exposure: .description. Synthetic narrative for platform contract tests.",
  "writeup": "Fixture stackstack-safe-exposure: .writeup. Synthetic narrative for platform contract tests.",
  "tags": [
    "stackstack",
    "authorization",
    "authentication",
    "multi-tenant",
    "access-control",
    "local-play",
    "container",
    "web-app"
  ],
  "exposedPorts": [
    {
      "port": 18080,
      "name": "Web (board / portal review)"
    },
    {
      "port": 18081,
      "name": "/verify (loopback)"
    }
  ],
  "learningGoals": [
    "認証 (誰か) と認可 (何をしてよいか) を、 同じリクエストの別の判定として区別できる",
    "公開したままにするエンドポイントと保護するエンドポイントを、 一覧の上で仕分けられる",
    "オブジェクトの owner / tenant / visibility が判定に参加する認可を、 宣言的なルールとして書ける",
    "一覧ルートと単体ルートを同じ判定で通し、 存在の有無を応答から漏らさない",
    "遮断だけで満足せず、 正常利用と監視経路が生きていることを実測で確かめる"
  ],
  "i18n": {
    "en": {
      "name": "Deciding Who Sees What",
      "shortDescription": "Fixture stackstack-safe-exposure: .i18n.en.shortDescription. Synthetic narrative for platform contract tests.",
      "instructions": "Fixture stackstack-safe-exposure: .i18n.en.instructions. Synthetic narrative for platform contract tests.",
      "description": "Fixture stackstack-safe-exposure: .i18n.en.description. Synthetic narrative for platform contract tests.",
      "writeup": "Fixture stackstack-safe-exposure: .i18n.en.writeup. Synthetic narrative for platform contract tests.",
      "learningGoals": [
        "Separate authentication (who is this) from authorization (may they do this) as two decisions about one request",
        "Sort the endpoints that stay public from the ones that must be protected, as a list you can check",
        "Express authorization where the object's owner / tenant / visibility participate in the decision, as declarative rules",
        "Run a collection route and an object route through one decision, and keep existence out of the response",
        "Refuse to stop at blocking: confirm by measurement that normal use and the monitoring path are still alive"
      ],
      "checks": [
        {
          "id": "exposed-record",
          "label": "The reference inside the customer's draft",
          "hints": [
            {
              "id": "exp-record-1",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.0.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "exp-record-2",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.0.hints.1.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "admin-sealed",
          "label": "Admin screens, for admins only",
          "hints": [
            {
              "id": "admin-seal-1",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.1.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "admin-seal-2",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.1.hints.1.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "admin-seal-3",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.1.hints.2.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "drafts-sealed",
          "label": "Drafts, for their owner and whoever they were shared with",
          "hints": [
            {
              "id": "drafts-seal-1",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.2.hints.0.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "drafts-seal-2",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.2.hints.1.content. Synthetic narrative for platform contract tests."
            },
            {
              "id": "drafts-seal-3",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.2.hints.2.content. Synthetic narrative for platform contract tests."
            }
          ]
        },
        {
          "id": "exposure-signoff",
          "label": "Sign-off for the exposure review",
          "hints": [
            {
              "id": "signoff-1",
              "content": "Fixture stackstack-safe-exposure: .i18n.en.checks.3.hints.0.content. Synthetic narrative for platform contract tests."
