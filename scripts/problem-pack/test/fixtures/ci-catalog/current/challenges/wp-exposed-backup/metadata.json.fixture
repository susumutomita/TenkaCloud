  "scoring": {
    "kind": "multi-verify",
    "hintReveal": "flat",
    "checks": [
      {
        "id": "public-backup",
        "label": "公開フォルダのバックアップ",
        "points": 30,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "public-backup-1",
            "content": "【観察】 サイト自体は正常に動いている。 だから WordPress 本体を攻めるのではない。 狙いは 「運用者が公開フォルダに置き忘れたファイル」 だ。 まず `/robots.txt` (検索エンジンへ 「ここは見ないで」 と頼む公開ファイル。 アクセス制限ではない) を開き、 隠したつもりで書かれた `Disallow` のフォルダを確認しよう。",
            "penalty": 0
          },
          {
            "id": "public-backup-2",
            "content": "【仮説】 サイト移行のとき、 運用者はデータベースを丸ごと書き出した 「バックアップ (ダンプ)」 を取ることが多い。 robots.txt に出ていた `/wp-content/backups/` に、 よくある名前 (`db-backup.sql` / `backup.sql` / `dump.sql`) で残っていないか試そう。",
            "penalty": 0
          },
          {
            "id": "public-backup-3",
            "content": "【確認と対策】 アクセス先 URL の `/wp-content/backups/db-backup.sql` を開くと DB のダンプが丸見えになる。 `maintenance_notes` の行に監査用の合言葉がある。 対策: バックアップを Web から届く場所に置かない・不要になったら削除する。",
            "penalty": 0
          }
        ]
      },
      {
        "id": "exposed-config",
        "label": "設定ファイルの控え",
        "points": 30,
        "wrongAnswerPenalty": 2,
        "hints": [
          {
            "id": "exposed-config-1",
            "content": "【観察】 設定ファイル `wp-config.php` 自体は PHP として実行されるので中身は見えない。 だが 「編集する前に取った控え」 が、 別の拡張子 (ファイル名末尾の `.php` や `.bak` のような、 種類を表す部分) で公開領域に残っていることがある。",
            "penalty": 0
          },
          {
            "id": "exposed-config-2",
            "content": "【仮説】 エディタは編集前に `wp-config.php.bak` / `.save` / `wp-config.php~` のような控えを作りがち。 `.bak` などは PHP として実行されず、 Apache がそのままプレーンテキストで返すので、 中身 (DB 接続情報など) が丸見えになる。",
            "penalty": 0
          },
          {
            "id": "exposed-config-3",
            "content": "【確認と対策】 アクセス先 URL の `/wp-config.php.bak` を開くと、 DB 接続情報と 「ops handoff token」 の行が読める。 その token が合言葉だ。 対策: 編集用の控えを公開領域に残さない (サーバの外で管理する)。",
            "penalty": 0
          }
        ]
      },
      {
        "id": "debug-log",
        "label": "本番に残ったログ",
        "points": 20,
        "wrongAnswerPenalty": 1,
        "hints": [
          {
            "id": "debug-log-1",
            "content": "【観察】 本番環境で付けっぱなしにすると危険な 「出力」 がある。 WordPress の開発・デバッグ機能を思い出そう ── 開発中に有効化して、 本番で切り忘れるものだ。",
            "penalty": 0
          },
          {
            "id": "debug-log-2",
            "content": "【仮説】 `WP_DEBUG_LOG` を有効にすると、 PHP のエラーやメモが `wp-content/debug.log` に書き出される。 本番で有効なままだと、 このログが誰でも読める場所に残る。",
            "penalty": 0
          },
          {
            "id": "debug-log-3",
            "content": "【確認と対策】 アクセス先 URL の `/wp-content/debug.log` を開き、 `[ops]` から始まる運用メモの行を読む。 そこに合言葉がある。 対策: 本番では `WP_DEBUG` / `WP_DEBUG_LOG` を無効化し、 ログを公開領域に置かない。",
            "penalty": 0
          }
        ]
      },
      {
        "id": "dir-listing",
        "label": "中身が見える内部フォルダ",
        "points": 20,
        "wrongAnswerPenalty": 1,
        "hints": [
          {
            "id": "dir-listing-1",
            "content": "【観察】 ファイル名を知らなくても、 フォルダを開くだけで中のファイルが全部見えてしまうことがある。 `/robots.txt` がもう一つ隠していたフォルダに注目しよう。",
            "penalty": 0
          },
          {
            "id": "dir-listing-2",
            "content": "【仮説】 `/internal/` のように `index.html` が無いフォルダは、 サーバのディレクトリ一覧 (Apache の `Indexes`) が有効なままだと、 開いた瞬間に中のファイルが一覧表示される。",
            "penalty": 0
          },
          {
            "id": "dir-listing-3",
            "content": "【確認と対策】 アクセス先 URL の `/internal/` を開くと、 引き継ぎメモ (`handover.txt`) が一覧に並ぶ。 それを開いて合言葉を読む。 対策: `Options -Indexes` でディレクトリ一覧を無効化し、 内部ファイルを公開領域に置かない。",
            "penalty": 0
          }
        ]
      }
    ]
  },
  "track": {
    "id": "stackstack-route",
    "order": 30,
    "chapter": "2. 壊れ方を知る"
  }
}
