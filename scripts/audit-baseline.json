{
  "version": 1,
  "description": "Approved set of npm packages with install-time lifecycle scripts (preinstall/install/postinstall/preprepare/prepare/postprepare). Bun's trustedDependencies model already blocks execution by default; this baseline pins the attack surface so any NEW package or NEW lifecycle hook in CI requires explicit human review. Update via: bun run scripts/audit-dependencies.ts --update",
  "entries": {
    "@eslint/eslintrc": ["prepare"],
    "@humanfs/core": ["prepare"],
    "@humanfs/node": ["prepare"],
    "@humanwhocodes/module-importer": ["prepare"],
    "@humanwhocodes/retry": ["prepare"],
    "@isaacs/balanced-match": ["prepare"],
    "@isaacs/brace-expansion": ["prepare"],
    "@isaacs/cliui": ["prepare"],
    "@kubernetes/client-node": ["prepare"],
    "@prisma/client": ["postinstall"],
    "@prisma/engines": ["postinstall"],
    "@so-ric/colorspace": ["prepare"],
    "@swc/core": ["postinstall"],
    "@textlint-ja/textlint-rule-preset-ai-writing": ["prepare"],
    "@textlint-rule/textlint-rule-no-invalid-control-character": ["prepare"],
    "@textlint-rule/textlint-rule-no-unmatched-pair": ["prepare"],
    "@textlint/regexp-string-matcher": ["prepare"],
    "acorn": ["prepare"],
    "acorn-walk": ["prepare"],
    "analyze-desumasu-dearu": ["prepare"],
    "aria-hidden": ["prepare"],
    "balanced-match": ["prepare"],
    "brace-expansion": ["prepare"],
    "cliui": ["prepare"],
    "colorette": ["prepare"],
    "cookie": ["prepare"],
    "dompurify": ["prepare"],
    "enhanced-resolve": ["prepare"],
    "entities": ["prepare"],
    "esbuild": ["postinstall"],
    "eventsource": ["prepare"],
    "express-rate-limit": ["prepare"],
    "foreground-child": ["prepare"],
    "get-caller-file": ["prepare"],
    "glob": ["prepare"],
    "globals": ["prepare"],
    "hashery": ["prepare"],
    "hono-openapi": ["prepare"],
    "hookified": ["prepare"],
    "istanbul-reports": ["prepare"],
    "jackspeak": ["prepare"],
    "jsdom": ["prepare"],
    "jsep": ["prepare"],
    "kuromojin": ["prepare"],
    "lightningcss": ["prepare"],
    "lru-cache": ["prepare"],
    "minimatch": ["prepare"],
    "minipass": ["prepare"],
    "node-fetch": ["prepare"],
    "openapi-types": ["prepare"],
    "package-json-from-dist": ["prepare"],
    "path-scurry": ["prepare"],
    "path-to-regexp": ["prepare"],
    "pathval": ["prepare"],
    "pino-abstract-transport": ["prepare"],
    "preact": ["prepare"],
    "prisma": ["preinstall"],
    "rc-config-loader": ["prepare"],
    "rfc4648": ["prepare"],
    "rimraf": ["prepare"],
    "rollup": ["prepare"],
    "sentence-splitter": ["prepare"],
    "sharp": ["install"],
    "signal-exit": ["prepare", "preprepare"],
    "tailwindcss-animate": ["prepare"],
    "textlint-rule-ja-no-mixed-period": ["prepare"],
    "textlint-rule-ja-no-redundant-expression": ["prepare"],
    "textlint-rule-max-ten": ["prepare"],
    "textlint-rule-no-doubled-joshi": ["prepare"],
    "textlint-rule-no-dropping-the-ra": ["prepare"],
    "textlint-rule-no-mix-dearu-desumasu": ["prepare"],
    "textlint-rule-preset-jtf-style": ["prepare"],
    "textlint-rule-sentence-length": ["prepare"],
    "textlint-util-to-string": ["prepare"],
    "thread-stream": ["prepare"],
    "tinyexec": ["prepare"],
    "ts-api-utils": ["prepare"],
    "ts-node": ["prepare"],
    "undici": ["prepare"],
    "whatwg-encoding": ["prepare"],
    "whatwg-url": ["prepare"],
    "y18n": ["prepare"],
    "yargs": ["prepare"],
    "yargs-parser": ["prepare"]
  }
