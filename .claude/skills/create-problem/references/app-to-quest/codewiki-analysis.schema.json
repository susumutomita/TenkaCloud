{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tenkacloud.example/schemas/codewiki-app-to-quest-analysis.json",
  "title": "Codewiki App-to-Quest Analysis",
  "description": "Expected shape of .codewiki/app-to-quest/analysis.json consumed by TenkaCloud App-to-Quest normalization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "summary",
    "techStack",
    "entrypoints",
    "dataModel",
    "authnAuthz",
    "dataFlows",
    "aiDataFlows",
    "secretsAndConfig",
    "loggingAndObservability",
    "deployment",
    "riskSignals",
    "unknowns"
  ],
  "properties": {
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "defaultBranch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "defaultBranch": { "$ref": "#/$defs/knownOrUnknown" }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "techStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "frameworks",
        "packageManagers",
        "datastores",
        "infrastructure",
        "externalServices"
      ],
      "properties": {
        "languages": { "$ref": "#/$defs/stringList" },
        "frameworks": { "$ref": "#/$defs/stringList" },
        "packageManagers": { "$ref": "#/$defs/stringList" },
        "datastores": { "$ref": "#/$defs/stringList" },
        "infrastructure": { "$ref": "#/$defs/stringList" },
        "externalServices": { "$ref": "#/$defs/stringList" }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/entrypoint" }
    },
    "dataModel": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataModelItem" }
    },
    "authnAuthz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication", "authorizationPatterns"],
      "properties": {
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "evidence"],
          "properties": {
            "provider": { "$ref": "#/$defs/knownOrUnknown" },
            "evidence": { "$ref": "#/$defs/stringList" }
          }
        },
        "authorizationPatterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizationPattern" }
        }
      }
    },
    "dataFlows": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataFlow" }
    },
    "aiDataFlows": {
      "type": "array",
      "items": { "$ref": "#/$defs/aiDataFlow" }
    },
    "secretsAndConfig": {
      "type": "array",
      "items": { "$ref": "#/$defs/secretConfig" },
      "description": "Names, usage, and evidence only. Secret values must not be stored."
    },
    "loggingAndObservability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logPoints", "auditLog", "evidence"],
      "properties": {
        "logPoints": { "$ref": "#/$defs/stringList" },
        "auditLog": {
          "type": "string",
          "enum": ["present", "absent", "unknown"]
        },
        "evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "iac", "runtime", "evidence"],
      "properties": {
        "platform": { "$ref": "#/$defs/stringList" },
        "iac": { "$ref": "#/$defs/stringList" },
        "runtime": { "$ref": "#/$defs/stringList" },
        "evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "riskSignals": {
      "type": "array",
      "items": { "$ref": "#/$defs/riskSignal" }
    },
    "unknowns": { "$ref": "#/$defs/stringList" }
  },
  "$defs": {
    "aiDataFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "dataSent", "evidence", "userConsent"],
      "properties": {
        "provider": { "$ref": "#/$defs/knownOrUnknown" },
        "dataSent": { "$ref": "#/$defs/stringList" },
        "evidence": { "$ref": "#/$defs/stringList" },
        "userConsent": {
          "type": "string",
          "enum": ["yes", "no", "unknown"]
        }
      }
    },
    "authorizationPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "boundary", "evidence", "confidence"],
      "properties": {
        "resource": { "type": "string", "minLength": 1 },
        "boundary": { "$ref": "#/$defs/knownOrUnknown" },
        "evidence": { "$ref": "#/$defs/stringList" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "dataFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "data", "evidence"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "data": { "$ref": "#/$defs/stringList" },
        "evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "dataModelItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "fields", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["table", "collection", "type", "schema", "unknown"]
        },
        "fields": { "$ref": "#/$defs/stringList" },
        "evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "method", "authRequired", "evidence"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["page", "api", "webhook", "job", "cli", "unknown"]
        },
        "method": { "$ref": "#/$defs/knownOrUnknown" },
        "authRequired": {
          "type": "string",
          "enum": ["yes", "no", "unknown"]
        },
        "evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "knownOrUnknown": {
      "type": "string",
      "minLength": 1
    },
    "riskSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "signal", "evidence", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "category": {
          "type": "string",
          "enum": ["security", "privacy", "reliability", "operations", "cost", "ai-safety"]
        },
        "signal": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/stringList" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "secretConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "usage", "source", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "usage": { "$ref": "#/$defs/knownOrUnknown" },
        "source": {
          "type": "string",
          "enum": ["env", "file", "secret-manager", "unknown"]
        },
        "evidence": { "$ref": "#/$defs/stringList" }
      },
      "description": "Secret variable metadata only. The schema intentionally has no field for secret values."
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
