# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.cpuprofile

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# AWS CDK synth output
cdk.out

# AWS CDK test synth output (issue #1295: keep cdk.out* out of $TMPDIR)
cdk.out.test/

# Nuxt.js build / generate output
.nuxt
dist

# Onboarding videos are published on YouTube; never commit rendered media.
landing/videos/onboarding/

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

.DS_Store
*.pdf

# Backup files
*.old

# Claude Code files
.claude/*
!.claude/settings.json
!.claude/templates/

.playwright-mcp
apps/*/test-results/
apps/*/playwright-report/
package-lock.json

tmp
.DS_Store
.codewiki/

# `make local` (local-play) runtime state: pid / deployment / runtime-config backup
# / api.log. Generated per run, never committed (and not linted — biome honors
# this file via vcs.useIgnoreFile).
.tenkacloud/

# Vestige of pre-PR-#398 layout. ソースは server/microservices/ に移行済み。
# working tree に残る node_modules/dist/lambda.zip は git 管理外 (本ディレクトリ自体を ignore)。
backend/
sampleimages/

# Agent commit-flow scratch files — never commit (one leaked in PR #2496, removed since)
.git-commit-msg.txt
.pr-body.md
.jscpd-report/

# packages/standalone-cli's prepack assembles a monorepo copy here before `npm pack`
# (scripts/assemble-runtime.mjs). Generated per run, shipped only inside the tarball.
packages/standalone-cli/runtime/
# Same script's own staging directory, created at the repository root (never inside
# `packages/`, which fs.cp() cannot copy into itself) and renamed away on success —
# only lingers after an interrupted run.
/.tenkacloud-runtime-staging-*/
