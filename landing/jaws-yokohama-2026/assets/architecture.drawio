<mxCell id="title" value="共通化する境界を変えた。" style="text;html=0;fontSize=44;fontStyle=1;align=left;fontColor=#172333" vertex="1" parent="1"><mxGeometry x="60" y="40" width="3100" height="70" as="geometry"/></mxCell>
<mxCell id="before" value="Before / cloud agnostic first" style="swimlane;html=0;startSize=65;fontSize=32;fontStyle=1;align=left;spacingLeft=25;fillColor=#fafbfc;swimlaneFillColor=#fafbfc;strokeColor=#405a78;strokeWidth=2;container=0" vertex="1" parent="1"><mxGeometry x="70" y="180" width="1440" height="1130" as="geometry"/></mxCell>
<mxCell id="after" value="After / AWS-native" style="swimlane;html=0;startSize=65;fontSize=32;fontStyle=1;align=left;spacingLeft=25;fillColor=#f9fcff;swimlaneFillColor=#f9fcff;strokeColor=#147eba;strokeWidth=2;container=0" vertex="1" parent="1"><mxGeometry x="1780" y="180" width="1440" height="1130" as="geometry"/></mxCell>
<mxCell id="before-intro" value="どのクラウドでも動く基盤を目指した。&#10;AWS / Azure / Google Cloudへの移植性。" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=28;fontSize=30;fontStyle=1;fillColor=#ffffff;strokeColor=#cfdbe6" vertex="1" parent="1"><mxGeometry x="120" y="290" width="1340" height="150" as="geometry"/></mxCell>
<mxCell id="before-auth" value="認証も自分で持つ / Keycloak&#10;更新・可用性・監視・障害対応。" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=28;fontSize=30;fillColor=#ffffff;strokeColor=#cfdbe6" vertex="1" parent="1"><mxGeometry x="120" y="490" width="1340" height="150" as="geometry"/></mxCell>
<mxCell id="before-runner" value="実行方式を共通化すると&#10;runner・権限・途中失敗からの復旧も基盤の責任。" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=28;fontSize=30;fillColor=#ffffff;strokeColor=#cfdbe6" vertex="1" parent="1"><mxGeometry x="120" y="690" width="1340" height="150" as="geometry"/></mxCell>
<mxCell id="before-state" value="Terraformを共通方式にした場合&#10;state・ロック・整合性・後片付けも設計対象。" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=28;fontSize=30;fillColor=#ffffff;strokeColor=#cfdbe6" vertex="1" parent="1"><mxGeometry x="120" y="890" width="1340" height="150" as="geometry"/></mxCell>
<mxCell id="before-result" value="「動かせる」と「運用し続けられる」は違った。" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=28;fontSize=30;fontStyle=1;fillColor=#fff1f2;strokeColor=#fca5a5;fontColor=#991b1b" vertex="1" parent="1"><mxGeometry x="120" y="1110" width="1340" height="145" as="geometry"/></mxCell>
