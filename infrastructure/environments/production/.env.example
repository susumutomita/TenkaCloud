
# #1766: tier 別の同時デプロイ上限 (JSON)。未設定ならクォータ無効。
# 超過した deploy は API が 429 (deploy_quota_exceeded) で弾く。tier 不明 / claim 不在は basic 扱い。
# CDK_PARAM_DEPLOY_QUOTA_BY_TIER={"basic":3,"advanced":10,"platinum":25}

# Issue #2423: battle app ingress allowlist for templates that declare an AllowedCidr
# parameter. Set this to score-engine and operator-attacker egress CIDRs before
# running multi-team events. Existing catalog templates use Type: String for
# AllowedCidr, so only the first CIDR is injected until a template accepts a list.
# CDK_PARAM_DEPLOY_ALLOWED_CIDRS=198.51.100.10/32,203.0.113.0/24

# CloudWatch Logs の保持日数 (= 全 Lambda の LogGroup retention)。未設定なら 1 日。
# AWS がサポートする離散値のみ可: 1,3,5,7,14,30,60,90,120,150,180,365,400,545,731,1827,3653
# 本番は監査要件に応じ 30 / 90 等へ上げることを推奨。
# CDK_PARAM_LOG_RETENTION_DAYS=30

# Issue #2961: AWS Budgets によるコスト監視。**既定 OFF (0)**。
# 値を 1 以上にしたときだけ Budget と SNS topic を作る。Free Tier alarms も同じ opt-in の内側。
#
# 既定を OFF にしたのは、deploy のたびに SNS の購読確認メールが届いていたため。stack を作り直すと
# topic は別の物理 resource になるので確認メールが再送され、未確認の購読は SubscriptionArn が
# 実 ARN ではなく "PendingConfirmation" のため **API でも手でも消せない**。AWS の自動失効を
# 待つしかないので、作らない側を既定にしてある。
#
# 本番でコスト上限を監視したい場合はここで明示的に有効化する。既定 OFF は「本番でも監視しなくて
# よい」という意味ではなく、**意図しない購読を作らない**ためであり、必要なら設定する側に倒す。
# MONTHLY_COST_LIMIT_USD=200
#
# 予算アラートの通知先は config.json の `budgetAlarmEmails` に**明示的に書いたときだけ**購読する。
# systemAdminEmail は「システム管理者の連絡先」であって「予算アラートを受け取りたい人」ではないので、
# 自動では購読しない。通知を Console で見る運用なら、限度額だけ設定して宛先は空のままでよい。

# Issue #2406: 採点停止 / 採点エラー / Always-On sweeper workflow failure / 月次コスト逸脱の
# 通知先。未設定なら ProblemDeployBackendStack の ops monitoring resources は作らない。
# CDK_PARAM_OPS_ALERT_EMAIL=ops@example.com
# CDK_PARAM_OPS_MONTHLY_COST_LIMIT_USD=10
# CDK_PARAM_OPS_BUDGET_THRESHOLD_PERCENT=100

# deploy artifact bucket の versioning を有効化するか。true / enabled / 1 で Enabled、
# それ以外 (未設定含む) は Suspended (= 旧 version の無限蓄積を防ぐコスト対策)。
# CDK_PARAM_SOURCE_BUCKET_VERSIONING=false

# Lite DynamoDB table の削除方針。default false では `make destroy` / DynamoDB -> Turso
# cutover が table と data を削除する。履歴を残す場合は、先に true で DynamoDB stack を
# 再 deploy する。RETAIN table は手動削除まで課金が続く。
# CDK_PARAM_RETAIN_DATA_TABLES=true

# Issues #2290, #2440, #2441, #2442: control-data repository backend.
# Events/Teams/Deployments/ProblemEndpoints/CompetitorAccounts/Disruptions/AdminAuditLog/
# SamlIdps control-data repository backend. Default is dynamodb (unset). See
# environments/development/.env.example for the full two-value semantics (#2677): dynamodb |
# turso (pure SQL, no DDB standing cost — none of the 8 tables above are synthesized). This
# also covers SamlIdps (#2499), the sole Lite-mode DynamoDB table outside
# ProblemDeployBackendStack, so `turso` yields a Lite synth with ZERO `AWS::DynamoDB::Table`
# resources. The `/tenant/idp*` SAML IdP CRUD API keeps working under `turso`, decoupled from
# DynamoDB table presence. See the README "Running costs" section for the opt-in walkthrough —
# implemented and unit/synth-tested, not yet live-verified end-to-end against a real Turso
# database.
# WARNING: switching an EXISTING production stack to turso removes the 8 DynamoDB resources.
# Default policy DELETE destroys their data. Export first. To keep a copy, redeploy the
# still-dynamodb stack with CDK_PARAM_RETAIN_DATA_TABLES=true before cutover; those tables then
# become orphaned and keep billing until manually deleted. The backends never sync (#2677 removed
# dual-write), and rolling back creates fresh DynamoDB tables without SQL-only writes.
# CDK_PARAM_CONTROL_DATA_BACKEND=turso
# CDK_PARAM_TURSO_DATABASE_URL=libsql://<database>-<organization>.turso.io
# CDK_PARAM_TURSO_AUTH_TOKEN_PARAMETER_NAME=/TenkaCloud/production/turso/auth-token
