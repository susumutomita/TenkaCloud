{
  "appName": "${APP_NAME:-TenkaCloud}",
  "accountId": "${AWS_ACCOUNT_ID}",
  "region": "${AWS_REGION:-ap-northeast-1}",
  "environment": "production",
  "controlPlaneConfig": {
    "systemAdminEmail": "${SYSTEM_ADMIN_EMAIL}",
    "systemAdminRoleName": "${SYSTEM_ADMIN_ROLE_NAME:-SystemAdmin}",
    "enableAdvancedSecurityMode": true,
    "setAPIGWScopes": true,
    "disableAPILogging": false,
    "apiThrottling": {
      "rateLimit": 100,
      "burstLimit": 50
    }
  },
  "appPlaneConfig": {
    "dynamoDbTablePrefix": "${APP_NAME:-TenkaCloud}",
    "cfnStackPrefix": "tenant"
  },
  "problemDeployConfig": {
    "targetRoleName": "tenkacloud-problem-deploy-role"
  },
  "dynamoDbConfig": {
    "billingMode": "PAY_PER_REQUEST",
    "pointInTimeRecovery": true
  }
}
