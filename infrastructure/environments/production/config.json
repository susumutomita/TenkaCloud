{
  "appName": "${APP_NAME:-TenkaCloud}",
  "accountId": "${AWS_ACCOUNT_ID}",
  "region": "${AWS_REGION:-ap-northeast-1}",
  "environment": "production",
  "controlPlaneConfig": {
    "systemAdminEmail": "${TenkaCloud_ADMIN_EMAIL}",
    "systemAdminRoleName": "${SYSTEM_ADMIN_ROLE_NAME:-SystemAdmin}",
    "enableAdvancedSecurityMode": true,
    "setAPIGWScopes": true,
    "disableAPILogging": false,
    "primaryCallbackUrl": "${TenkaCloud_HOSTED_UI_CALLBACK_URL}",
    "additionalCallbackUrls": ["${TenkaCloud_HOSTED_UI_CALLBACK_URL}"],
    "additionalLogoutUrls": ["${TenkaCloud_HOSTED_UI_LOGOUT_URL}"],
    "allowedCorsOrigins": ["${TenkaCloud_ADMIN_CONSOLE_ORIGIN}"]
  },
  "bootstrapConfig": {
    "tenantCfnStackPrefix": "TenkaCloud-tenant"
  },
  "dynamoDbConfig": {
    "billingMode": "${DYNAMODB_BILLING_MODE:-PROVISIONED}",
    "readCapacity": "${DYNAMODB_READ_CAPACITY:-1}",
    "writeCapacity": "${DYNAMODB_WRITE_CAPACITY:-1}"
  }
}
