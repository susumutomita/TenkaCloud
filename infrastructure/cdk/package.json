  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.195.1",
    "typescript": "~5.7.0",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@cdklabs/sbt-aws": "^0.9.1",
    "aws-cdk-lib": "^2.195.1",
    "constructs": "^10.3.0"
  }
}
