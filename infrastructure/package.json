{
  "name": "@TenkaCloud/infrastructure",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cdk": "bin/infrastructure.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "synth": "../scripts/run-cdk.sh synth -c environment=${ENV:-development}",
    "test": "bun run test/run-vitest.ts run",
    "test:coverage": "bun run test/run-vitest.ts run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='cdk.out/**' --coverage.exclude='**/*.test.ts' --coverage.exclude='test/**'",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cdk": "../scripts/run-cdk.sh",
    "pack": "tsx bin/tenkacloud-pack.ts",
    "_synth-app": "tsx bin/infrastructure.ts"
  },
  "devDependencies": {
    "@aws-cdk/cloud-assembly-schema": "54.14.0",
    "@aws-sdk/client-cloudformation": "^3.1079.0",
    "@aws-sdk/client-cloudwatch": "^3.1085.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1105.0",
    "@aws-sdk/client-dynamodb": "^3.1079.0",
    "@aws-sdk/client-eventbridge": "^3.1079.0",
    "@aws-sdk/client-lambda": "^3.1079.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-ssm": "^3.1079.0",
    "@aws-sdk/client-sts": "^3.1099.0",
    "@aws-sdk/lib-dynamodb": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@biomejs/biome": "^2.5.3",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^26.1.0",
    "aws-cdk": "2.1133.0",
    "cdk-nag": "^3.0.1",
    "hono": "^4.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "ulid": "^2.4.0",
    "vitest": "^4.1.9",
    "yaml": "^1.10.3",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@TenkaCloud/trust-bridge": "workspace:*",
    "@aws-cdk/aws-lambda-python-alpha": "^2.140.0-alpha.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-budgets": "^3.1095.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1079.0",
    "@aws-sdk/client-codebuild": "^3.1079.0",
    "@aws-sdk/client-codepipeline": "^3.1079.0",
    "@aws-sdk/client-scheduler": "^3.1105.0",
    "@aws-sdk/client-sfn": "^3.1090.0",
    "@aws-sdk/credential-provider-node": "^3.972.42",
    "@cdklabs/sbt-aws": "0.9.5",
    "@libsql/client": "^0.17.4",
    "@smithy/protocol-http": "^5.5.10",
    "@smithy/signature-v4": "^5.4.3",
    "@smithy/types": "^4.14.2",
    "@tenkacloud/coordination-plugin-sdk": "workspace:*",
    "@tenkacloud/portal-contracts": "workspace:*",
    "@tenkacloud/problem-runtime": "workspace:*",
    "@tenkacloud/problem-sdk": "workspace:*",
    "@tenkacloud/saml-utils": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "aws-cdk-lib": "2.262.1",
    "constructs": "^10.8.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.1",
    "http-status-codes": "^2.3.0",
    "winston": "^3.19.0"
  }
}
