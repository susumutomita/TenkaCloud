{
  "name": "@TenkaCloud/infrastructure",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cdk": "bin/infrastructure.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "synth": "cdk synth -c environment=${ENV:-development}",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='cdk.out/**' --coverage.exclude='**/*.test.ts' --coverage.exclude='test/**'",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cdk": "cdk",
    "_synth-app": "tsx bin/infrastructure.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1048.0",
    "@aws-sdk/client-cloudwatch": "^3.1048.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1048.0",
    "@aws-sdk/client-dynamodb": "^3.1048.0",
    "@aws-sdk/client-eventbridge": "^3.1048.0",
    "@aws-sdk/client-lambda": "^3.1048.0",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/client-ssm": "^3.1048.0",
    "@aws-sdk/client-sts": "^3.1047.0",
    "@aws-sdk/lib-dynamodb": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@biomejs/biome": "^2.4.15",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^24.12.4",
    "aws-cdk": "2.1122.0",
    "cdk-nag": "^2.38.2",
    "hono": "^4.12.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.1",
    "typescript": "~5.9.3",
    "ulid": "^2.4.0",
    "vitest": "^4.1.6",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@TenkaCloud/trust-bridge": "workspace:*",
    "@aws-cdk/aws-lambda-python-alpha": "^2.140.0-alpha.0",
    "@aws-sdk/client-codebuild": "^3.1048.0",
    "@aws-sdk/client-codepipeline": "^3.1048.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1053.0",
    "@aws-sdk/client-sfn": "^3.1048.0",
    "@cdklabs/sbt-aws": "0.3.9",
    "ajv": "8.18.0",
    "ajv-formats": "^3.0.1",
    "aws-cdk-lib": "^2.256.1",
    "constructs": "^10.6.0",
    "dotenv": "^17.4.2",
    "http-status-codes": "^2.3.0",
    "winston": "^3.19.0"
  }
}
