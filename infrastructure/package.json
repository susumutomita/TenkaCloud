{
  "name": "@tenkacloud/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.verification.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.verification.json",
    "test": "bun run test/run-vitest.ts run",
    "test:coverage": "bun run test/run-vitest.ts run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='test/**' --coverage.exclude='cdk.out/**'"
  },
