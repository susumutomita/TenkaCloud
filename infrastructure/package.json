    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cloudformation": "3.1140.0",
    "@aws-sdk/client-cloudwatch": "^3.1140.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1140.0",
    "@aws-sdk/client-codebuild": "^3.1140.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1145.0",
    "@aws-sdk/client-dynamodb": "3.1140.0",
    "@aws-sdk/client-eventbridge": "^3.1140.0",
    "@aws-sdk/client-lambda": "^3.1140.0",
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/client-scheduler": "^3.1140.0",
    "@aws-sdk/client-sfn": "3.1140.0",
    "@aws-sdk/client-ssm": "3.1140.0",
    "@aws-sdk/client-sts": "3.1140.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/lib-dynamodb": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@libsql/client": "^0.17.4",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.4.3",
    "@smithy/types": "^4.19.0",
    "@tenkacloud/coordination-plugin-sdk": "workspace:*",
    "@tenkacloud/portal-contracts": "workspace:*",
    "@tenkacloud/problem-runtime": "workspace:*",
    "@tenkacloud/problem-sdk": "workspace:*",
    "@tenkacloud/saml-utils": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "aws-cdk-lib": "2.262.1",
    "constructs": "10.8.1",
    "fflate": "^0.8.1",
    "hono": "4.13.9",
