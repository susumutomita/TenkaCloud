{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "appName",
    "accountId",
    "region",
    "environment",
    "controlPlaneConfig",
    "bootstrapConfig"
  ],
  "$defs": {
    "samlIdpConfig": {
      "type": "object",
      "required": ["metadataUrl"],
      "properties": {
        "metadataUrl": {
          "type": "string",
          "format": "uri",
          "description": "IdP の SAML federation metadata XML を取得する HTTPS URL。 Entra ID / Okta / Google Workspace が expose する URL を貼る。"
        },
        "attributeMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "SAML AttributeStatement Name → Cognito attribute name のマップ。 未指定なら email のみ自動。"
        },
        "providerName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{3,32}$",
          "description": "Cognito IdP の表示名 (= Hosted UI button label)。 URL 安全な英数字 + -_ のみ。 default `CompanySAML`。"
        },
        "enforceSamlOnly": {
          "type": "boolean",
          "description": "true で username/password 経路を無効化 (= SAML のみで sign-in 可)。 既存 user 救済のため初回展開は false 推奨。"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "appName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "controlPlaneConfig": {
      "type": "object",
      "required": ["systemAdminEmail"],
      "properties": {
        "systemAdminEmail": { "type": "string", "format": "email" },
        "systemAdminRoleName": { "type": "string", "default": "SystemAdmin" },
        "enableAdvancedSecurityMode": { "type": "boolean", "default": true },
        "setAPIGWScopes": { "type": "boolean", "default": true },
        "disableAPILogging": { "type": "boolean", "default": false },
        "primaryCallbackUrl": { "type": "string", "format": "uri" },
        "additionalCallbackUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1
        },
        "additionalLogoutUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1
        },
        "allowedCorsOrigins": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1
        },
        "samlIdp": { "$ref": "#/$defs/samlIdpConfig" }
      },
      "additionalProperties": false
    },
    "tenantSamlConfig": { "$ref": "#/$defs/samlIdpConfig" },
    "bootstrapConfig": {
      "type": "object",
      "required": ["tenantCfnStackPrefix"],
      "properties": {
        "tenantCfnStackPrefix": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dynamoDbConfig": {
      "type": "object",
      "required": ["billingMode"],
      "properties": {
        "billingMode": {
          "type": "string",
          "enum": ["PROVISIONED", "PAY_PER_REQUEST"]
        },
        "readCapacity": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[1-9][0-9]*$" }
          ]
        },
        "writeCapacity": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^[1-9][0-9]*$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "kmsConfig": {
      "type": "object",
      "properties": {
        "pendingWindowInDays": {
          "anyOf": [
            { "type": "integer", "minimum": 7, "maximum": 30 },
            { "type": "string", "pattern": "^([7-9]|[12][0-9]|30)$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "sourceBundleConfig": {
      "type": "object",
      "required": ["keepNoncurrentVersions", "expireAfterDays"],
      "properties": {
        "keepNoncurrentVersions": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 100 },
            { "type": "string", "pattern": "^[1-9][0-9]?$|^100$" }
          ],
          "description": "旧 version の保持世代数 (= AWS NewerNoncurrentVersions)。"
        },
        "expireAfterDays": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 365 },
            { "type": "string", "pattern": "^[1-9][0-9]{0,2}$|^36[0-5]$" }
          ],
          "description": "Noncurrent 化してから expire までの日数 (= AWS NoncurrentDays)。"
        }
      },
      "additionalProperties": false
    },
    "monthlyCostLimitUsd": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+$" }]
    },
    "budgetAlarmEmails": {
      "type": "array",
      "items": { "type": "string", "format": "email" }
    }
  },
  "additionalProperties": false
}
