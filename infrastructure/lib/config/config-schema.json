{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "appName",
    "accountId",
    "region",
    "environment",
    "controlPlaneConfig",
    "appPlaneConfig",
    "problemDeployConfig",
    "dynamoDbConfig"
  ],
  "properties": {
    "appName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$",
      "description": "Application name used as prefix for all AWS resources"
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9]{12}$",
      "description": "AWS Account ID (12 digits)"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$",
      "description": "AWS region (e.g. ap-northeast-1)"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "controlPlaneConfig": {
      "type": "object",
      "required": ["systemAdminEmail"],
      "properties": {
        "systemAdminEmail": {
          "type": "string",
          "format": "email"
        },
        "systemAdminRoleName": {
          "type": "string",
          "default": "SystemAdmin"
        },
        "enableAdvancedSecurityMode": {
          "type": "boolean",
          "default": true
        },
        "setAPIGWScopes": {
          "type": "boolean",
          "default": true
        },
        "disableAPILogging": {
          "type": "boolean",
          "default": false
        },
        "apiThrottling": {
          "type": "object",
          "required": ["rateLimit", "burstLimit"],
          "properties": {
            "rateLimit": {
              "type": "number",
              "minimum": 1,
              "description": "Steady-state requests per second"
            },
            "burstLimit": {
              "type": "number",
              "minimum": 1,
              "description": "Maximum burst capacity"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "appPlaneConfig": {
      "type": "object",
      "required": ["dynamoDbTablePrefix", "cfnStackPrefix"],
      "properties": {
        "dynamoDbTablePrefix": {
          "type": "string"
        },
        "cfnStackPrefix": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "problemDeployConfig": {
      "type": "object",
      "required": ["targetRoleName"],
      "properties": {
        "targetRoleName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dynamoDbConfig": {
      "type": "object",
      "required": ["billingMode"],
      "properties": {
        "billingMode": {
          "type": "string",
          "enum": ["PROVISIONED", "PAY_PER_REQUEST"]
        },
        "readCapacity": {
          "type": "number",
          "minimum": 1,
          "description": "Read capacity units (PROVISIONED mode only)"
        },
        "writeCapacity": {
          "type": "number",
          "minimum": 1,
          "description": "Write capacity units (PROVISIONED mode only)"
        },
        "pointInTimeRecovery": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
