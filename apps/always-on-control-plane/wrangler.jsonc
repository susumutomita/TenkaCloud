{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Private signing material is never a var. Configure it with:
  // bunx wrangler secret put OIDC_SIGNING_PRIVATE_JWK --env <environment>   (ADR-050 OIDC IdP + command key)
  "name": "tenkacloud-always-on-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  // Control-plane reconciliation (event status transitions + prune) every 5 minutes,
  // so Always-On mode needs no constant AWS tick (ADR-049 Phase 5 / #2294).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "AUTH0_ISSUER": "https://replace-me.auth0.com/",
    "AUTH0_AUDIENCE": "https://api.tenkacloud.dev",
    "AUTH0_CLIENT_ID": "replace-me",
    "AUTH0_ROLES_CLAIM": "https://tenkacloud.dev/roles",
    // The one origin this Worker answers on. MCP Host/Origin validation and the
    // advertised protected-resource URL come from here, never from the request.
    // `wrangler dev` serves the loopback origin below; every deployed
    // environment must replace its placeholder or the MCP routes fail closed.
    "MCP_CANONICAL_ORIGIN": "http://localhost:8787",
    // ADR-050 OIDC command seam: role/bus from `make deploy-always-on-command` outputs;
    // PROBLEMS_CATALOG is the JSON problemId -> problemDir map offered in Always-On events.
    "COMMAND_ROLE_ARN": "arn:aws:iam::000000000000:role/tenkacloud-alwayson-command",
    "COMMAND_AWS_REGION": "ap-northeast-1",
    "COMMAND_EVENT_BUS_ARN": "arn:aws:events:ap-northeast-1:000000000000:event-bus/replace-me",
    "PROBLEMS_CATALOG": "{}"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "tenkacloud-always-on-control-plane-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "tenkacloud-always-on-control-plane-staging",
      "vars": {
        "AUTH0_ISSUER": "https://replace-me-staging.auth0.com/",
        "AUTH0_AUDIENCE": "https://staging-api.tenkacloud.dev",
        "AUTH0_CLIENT_ID": "replace-me-staging",
        "AUTH0_ROLES_CLAIM": "https://tenkacloud.dev/roles",
        "MCP_CANONICAL_ORIGIN": "https://replace-me-staging.example.invalid",
        "COMMAND_ROLE_ARN": "arn:aws:iam::000000000000:role/tenkacloud-alwayson-command",
        "COMMAND_AWS_REGION": "ap-northeast-1",
        "COMMAND_EVENT_BUS_ARN": "arn:aws:events:ap-northeast-1:000000000000:event-bus/replace-me",
        "PROBLEMS_CATALOG": "{}"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "tenkacloud-always-on-control-plane-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "tenkacloud-always-on-control-plane-production",
      "vars": {
        "AUTH0_ISSUER": "https://replace-me.auth0.com/",
        "AUTH0_AUDIENCE": "https://api.tenkacloud.dev",
        "AUTH0_CLIENT_ID": "replace-me",
        "AUTH0_ROLES_CLAIM": "https://tenkacloud.dev/roles",
        "MCP_CANONICAL_ORIGIN": "https://replace-me.example.invalid",
        "COMMAND_ROLE_ARN": "arn:aws:iam::000000000000:role/tenkacloud-alwayson-command",
        "COMMAND_AWS_REGION": "ap-northeast-1",
        "COMMAND_EVENT_BUS_ARN": "arn:aws:events:ap-northeast-1:000000000000:event-bus/replace-me",
        "PROBLEMS_CATALOG": "{}"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "tenkacloud-always-on-control-plane-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
