{
  "name": "@tenkacloud/always-on-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --env \"\" --outdir dist",
    "types": "wrangler types --include-runtime false",
    "types:check": "wrangler types --include-runtime false --check",
    "typecheck": "tsc --noEmit && bun run types:check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage"
  },
  "dependencies": {
    "@TenkaCloud/trust-bridge": "workspace:*",
    "@tenkacloud/auth-client": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.31",
    "http-status-codes": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^5.20260703.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
