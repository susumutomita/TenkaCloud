{
  "name": "@TenkaCloud/admin-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts*'"
  },
  "dependencies": {
    "@cloudscape-design/components": "^3.0.1338",
    "@cloudscape-design/global-styles": "^1.0.61",
    "@tenkacloud/auth-client": "workspace:*",
    "@tenkacloud/format": "workspace:*",
    "@tenkacloud/web-kit": "workspace:*",
    "http-status-codes": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  }
}
