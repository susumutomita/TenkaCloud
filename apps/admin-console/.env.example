# apps/admin-console の dev (bun run dev) 用設定
# このファイルを .env.local にコピーして値を埋める:
#   cp apps/admin-console/.env.example apps/admin-console/.env.local
#
# production (CloudFront 配信) では /runtime-config.json を起動時に fetch する方式なので
# この .env.local は dev ローカル起動時の fallback 用。
#
# Cognito UserPool Id / client ID / API URL は ControlPlaneStack deploy 後の output から取る:
#   aws cloudformation describe-stacks --stack-name ControlPlaneStack --query "Stacks[0].Outputs"
#   aws cognito-idp describe-user-pool --user-pool-id <id> --query "UserPool.Domain"
#
# redirect URI は admin-console が window.location.origin から自動解決するので指定不要。

VITE_COGNITO_DOMAIN=https://<domain>.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<UserPoolUserClientId>
VITE_API_BASE_URL=https://<api-id>.execute-api.ap-northeast-1.amazonaws.com
