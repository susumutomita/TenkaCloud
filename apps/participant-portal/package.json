{
  "name": "@TenkaCloud/participant-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc -p tsconfig.build.json && vite build && bun run scripts/assert-no-writeups-in-dist.ts",
    "build:pages": "vite build --base ${PORTAL_BASE:-/portal-demo/} && bun run scripts/assert-no-writeups-in-dist.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts*'"
  },
  "dependencies": {
    "@cloudscape-design/components": "^3.0.1355",
    "@cloudscape-design/global-styles": "^1.0.61",
    "@tenkacloud/format": "workspace:*",
    "@tenkacloud/portal-contracts": "workspace:*",
    "@tenkacloud/web-kit": "workspace:*",
    "@tenkacloud/portal-plugin-sdk": "workspace:*",
    "http-status-codes": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
