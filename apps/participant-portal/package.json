{
  "name": "@TenkaCloud/participant-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts*'"
  },
  "dependencies": {
    "@cloudscape-design/components": "^3.0.1308",
    "@cloudscape-design/global-styles": "^1.0.60",
    "@tenkacloud/format": "workspace:*",
    "@tenkacloud/web-kit": "workspace:*",
    "@tenkacloud/portal-plugin-sdk": "workspace:*",
    "http-status-codes": "^2.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.15.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.8"
  }
}
