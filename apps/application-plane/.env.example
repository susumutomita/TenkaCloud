# NextAuth.js Configuration
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:13001

# Auth0 Configuration
# Get these from your Auth0 Dashboard > Applications > Your App
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://your-tenant.auth0.com

# Authentication Skip Mode (Development Only)
# Set to "1" to bypass Auth0 authentication with a mock session
# WARNING: Only use for local development, never in production
# AUTH_SKIP=1

# Problem Service API URL (backend for events, problems, scoring)
NEXT_PUBLIC_API_URL=http://localhost:3100/api

# GameDay Service API URL
NEXT_PUBLIC_GAMEDAY_API_URL=http://localhost:3020/api/gameday

# AWS Configuration for STS Federation
AWS_REGION=ap-northeast-1
