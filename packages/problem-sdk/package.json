{
  "name": "@tenkacloud/problem-sdk",
  "version": "0.2.0",
  "description": "The only supported public authoring contract for TenkaCloud problem packs (#2106): stable types, validators, constants, and namespaced diagnostic codes. Dependency-light, deterministic, and free of CDK / AWS SDK / Lambda / browser code.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "tenkacloud-pack-report": "bin/pack-report.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pack-report": "bun bin/pack-report.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "dependencies": {
    "@tenkacloud/problem-runtime": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "http-status-codes": "^2.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
