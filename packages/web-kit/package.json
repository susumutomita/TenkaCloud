{
  "name": "@tenkacloud/web-kit",
  "version": "0.1.0",
  "description": "Shared TenkaCloud SPA UI primitives — design-system components (Issue #1418 / #1366)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
