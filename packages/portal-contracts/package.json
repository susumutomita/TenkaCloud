{
  "name": "@tenkacloud/portal-contracts",
  "version": "0.1.0",
  "description": "Shared participant portal API wire contract — one definition consumed by both the participant-handler backend and the participant-portal SPA (Issue #2203)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
