{
  "name": "@tenkacloud/problem-runtime",
  "version": "0.1.0",
  "description": "Single source of truth for problem runtime classification and capability evidence. Shared by deploy workers, authoring tools, runtime selection, and generated documentation.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./capabilities": "./src/capabilities.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
