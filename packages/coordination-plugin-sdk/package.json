{
  "name": "@tenkacloud/coordination-plugin-sdk",
  "version": "0.1.0",
  "description": "ADR-028 inter-team coordination plugin contract (state machine + 5 hooks) shared by problems and the platform dispatcher (Issue #1420)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
