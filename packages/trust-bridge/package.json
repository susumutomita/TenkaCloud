{
  "name": "@TenkaCloud/trust-bridge",
  "version": "0.1.0",
  "description": "Cross-cloud authority transfer library for converting signed CloudActionIntent values into short-lived provider-native credentials, with canonical serialization, JWS verification, TTL, replay protection, and audit records (#795).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "poc:cep": "bun poc/customer-execution-plane-demo.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
