{
  "name": "@TenkaCloud/trust-bridge",
  "version": "0.1.0",
  "description": "Cross-cloud authority transfer library (= signed CloudActionIntent → short-lived provider-native credentials). Phase 1: schema + canonical serialization + JWS sign/verify + TTL + nonce hook + audit (#795 / ADR-017).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
