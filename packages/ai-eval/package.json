{
  "name": "@tenkacloud/ai-eval",
  "version": "0.1.0",
  "description": "Evaluation contracts for TenkaCloud AI features (Issue 2936 Phase 1): versioned targets, golden cases, run results, and the release-gate decision. AWS-independent and deterministic.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=./coverage --coverage.exclude='dist/**' --coverage.exclude='**/*.test.ts'"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
