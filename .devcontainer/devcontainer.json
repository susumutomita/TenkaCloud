{
  "name": "TenkaCloud host development",
  "image": "mcr.microsoft.com/devcontainers/universal:noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": false
    }
  },
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb"
  },
  "remoteEnv": {
    "BUN_INSTALL": "/home/codespace/.bun",
    "PATH": "/home/codespace/.bun/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": ["bash", ".devcontainer/post-create.sh"],
  "forwardPorts": [5174, 5175],
  "portsAttributes": {
    "5174": {
      "label": "Host organizer",
      "onAutoForward": "notify"
    },
    "5175": {
      "label": "Participant portal",
      "onAutoForward": "notify"
    }
  }
}
